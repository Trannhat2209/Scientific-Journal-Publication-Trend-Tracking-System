{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SQL_SERVER;Database=ScientificJournalDB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true",
    "MongoConnection": "mongodb://localhost:27017",
    "MongoDatabaseName": "scientific_journal_raw_db"
  },
  "Payments": {
    "InternalSyncSecret": "replace-with-shared-payment-sync-secret",
    "FrontendUrl": "http://localhost:5174",
    "PendingTtlSeconds": 900,
    "PayOS": {
      "ClientId": "",
      "ApiKey": "",
      "ChecksumKey": ""
    }
  },
  "Jwt": {
    "Secret": "replace-with-a-secure-jwt-secret-at-least-32-characters",
    "ExpiryInDays": 7
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "Username": "",
    "Password": "",
    "From": ""
  }
}
