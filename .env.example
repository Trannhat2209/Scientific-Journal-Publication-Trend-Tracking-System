GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
FRONTEND_URL=http://localhost:5174
API_PORT=5173
APP_SESSION_SECRET=replace-with-a-long-random-string

# Main .NET API used by Vite through vite.config.js proxy.
VITE_API_BASE_URL=

# Optional Node OAuth helper used only by the Google buttons.
VITE_GOOGLE_AUTH_BASE_URL=http://localhost:5173

# Server-side Google Scholar lookup through SerpApi.
SERPAPI_API_KEY=your-serpapi-key

# PayOS checkout for Upgrade to Pro.
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key
PAYOS_MONTHLY_AMOUNT=125000
PAYOS_YEARLY_AMOUNT=1225000
PAYMENT_PENDING_TTL_SECONDS=900

# Node PayOS server calls the .NET API with this shared secret when payment is PAID.
DOTNET_API_BASE_URL=http://localhost:5227
PAYMENT_SYNC_SECRET=dev-payment-sync-secret
