GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
FRONTEND_URL=http://localhost:5174
API_PORT=5173
APP_SESSION_SECRET=replace-with-a-long-random-string

# SMTP email delivery. For Gmail use smtp.gmail.com:587 and a 16-character
# Google App Password (never your normal Google password).
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__Username=your-sender@gmail.com
Smtp__Password=your-16-character-app-password
Smtp__From=your-sender@gmail.com

# ORCID OAuth (use sandbox.orcid.org while developing). ORCID requires a
# registered public HTTPS callback; replace auth.example.com with your domain
# or HTTPS tunnel and open the app through the same auth origin.
ORCID_CLIENT_ID=APP-XXXXXXXXXXXXXXX
ORCID_CLIENT_SECRET=replace-with-orcid-client-secret
ORCID_REDIRECT_URI=https://auth.example.com/api/auth/orcid/callback
ORCID_BASE_URL=https://sandbox.orcid.org

# Institution OpenID Connect / Microsoft Entra ID.
INSTITUTION_OIDC_CLIENT_ID=replace-with-application-client-id
INSTITUTION_OIDC_CLIENT_SECRET=replace-with-client-secret
INSTITUTION_OIDC_TENANT_ID=replace-with-directory-tenant-id
INSTITUTION_OIDC_REDIRECT_URI=https://auth.example.com/api/auth/institution/callback
INSTITUTION_OIDC_ISSUER=https://login.microsoftonline.com/replace-with-directory-tenant-id/v2.0

# Main .NET API used by Vite through vite.config.js proxy.
VITE_API_BASE_URL=

# Optional Node OAuth helper used only by the Google buttons.
VITE_GOOGLE_AUTH_BASE_URL=http://localhost:5173

# Server-side Google Scholar lookup through SerpApi.
SERPAPI_API_KEY=your-serpapi-key

# Optional OpenAlex API key. Anonymous OpenAlex calls can be temporarily rate-limited.
OPENALEX_API_KEY=your-openalex-api-key

# Optional future provider. Connected Papers requires approved API access and
# a seed paper DOI/ID; the similarity engine reports it as unavailable until set.
CONNECTED_PAPERS_API_KEY=your-connected-papers-api-key

# Optional Semantic Scholar Graph API key. Anonymous calls are heavily rate-limited.
SEMANTIC_SCHOLAR_API_KEY=your-semantic-scholar-api-key
